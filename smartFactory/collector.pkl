import
"./events.pkl"
as Events
import
"https://raw.githubusercontent.com/CollaborativeStateMachines/Cirrina/refs/heads/develop/src/main/resources/pkl/csm/csml.pkl"

sm = new csml.StateMachine {
  states {
    ["collecting"] = new csml.Initial {
      on {
        [Events.ePartAssemblyInitiated] {
          to = "collecting"
        }

        [Events.eJobDone] {
          to = "terminated"
        }
      }
    }

    ["terminated"] = new csml.Terminal {}
  }
}
