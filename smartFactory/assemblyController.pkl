import
  "https://raw.githubusercontent.com/AryanP281/Cirrina-CSML-SmartFactory/refs/heads/develop/smartFactory/events.pkl"
  as Events
import
  "https://raw.githubusercontent.com/AryanP281/Cirrina-CSML-SmartFactory/refs/heads/develop/smartFactory/serviceTypes.pkl"
  as ServiceTypes
import
  "https://raw.githubusercontent.com/CollaborativeStateMachines/Cirrina/refs/heads/develop/src/main/resources/pkl/csm/csml.pkl"

sm = new csml.StateMachine {
  transient = new Mapping {
    ["nextReceivedPartId"] = "0L"
    ["nextPartToProcessId"] = "0L"
  }

  states {
    ["detectingStart"] = new csml.Initial {
      entry {
        new csml.Match {
          cases {
            new csml.Case {
              of = "(nextReceivedPartId - nextPartToProcessId) > 0"
              yields {
                new csml.Emit { event = new csml.Internal { topic = Events.ePartDetectedAtStart} }
              }
            }
          }
        }
      }

      on {
        [Events.eBeamInterruptedStart] {
          to = "detectingStart"
          yields {
            new csml.Eval {
              expression = "nextReceivedPartId += 1"
            }
          }
        }

        [Events.ePartDetectedAtStart] {
          to = "capturePhoto"
          yields {
            new csml.Emit {event {topic = Events.ePartAssemblyInitiated; data {
              ["partId"] = "nextPartToProcessId"
            }}
            target = "'collector'"}
          }
        }

        [Events.eJobDone] {
          to = "jobDone"
        }
      }
    }

    ["capturePhoto"] = new csml.State {
      entry {
        new csml.Invoke {
          type = ServiceTypes.stTakePhoto
        }
      }

      on {
        [Events.ePhotoCaptured] {
          to = "scanPhoto"
        }

        [Events.eJobDone] {
          to = "jobDone"
        }

        [Events.eBeamInterruptedStart] {
          yields {
            new csml.Eval {
              expression = "nextReceivedPartId += 1"
            }
          }
        }
      }
    }

    ["scanPhoto"] = new csml.State {
      entry {
        new csml.Invoke {
          type = ServiceTypes.stScanPhoto
          input {
            ["imgData"] = "$data"
          }
        }
      }

      exit {
        new csml.Emit { event { topic = Events.eScanned }; target = "'monitor'" }
      }

      on {
        [Events.ePhotoScanned] {
          yields {
            new csml.Match {
              cases {
                new csml.Case {
                  of = "$validObject"
                  yields {
                    new csml.Emit { event = new csml.Internal { topic = Events.eCheckValidObject } }
                  }
                }
                new csml.Case {
                  of = "!($validObject)"
                  yields {
                    new csml.Emit {
                      event = new csml.Internal { topic = Events.eCheckInvalidObject }
                    }
                  }
                }
              }
            }
          }
        }

        [Events.eCheckInvalidObject] {
          to = "error"
        }

        [Events.eCheckValidObject] {
          to = "detectingEnd"
          yields {
            new csml.Emit {
              event = new csml.Event { topic = Events.eObjectValid; data {
                ["partId"] = "nextPartToProcessId"
              } }
              target = "'conveyorBelt'"
            }
          }
        }

        [Events.eJobDone] {
          to = "jobDone"
        }

        [Events.eBeamInterruptedStart] {
          yields {
            new csml.Eval {
              expression = "nextReceivedPartId += 1"
            }
          }
        }
      }
    }

    ["error"] = new csml.State {
      entry {
        new csml.Emit {
          event {
            topic = Events.eProcessMessage
            data { ["msg"] = "'Assembly error: Invalid object detected'" }
          }
          target = "'messageProcessor'"
        }

        new csml.Invoke {
          type = ServiceTypes.stDiscardObject
        }
      }

      on {
        [Events.eJobDone] {
          to = "jobDone"
        }

        [Events.eObjectDiscarded] {
          to = "detectingStart"
          yields {
            new csml.Eval {expression = "nextPartToProcessId += 1"}
          }
        }

        [Events.eBeamInterruptedStart] {
          yields {
            new csml.Eval {
              expression = "nextReceivedPartId += 1"
            }
          }
        }
      }
    }

    ["detectingEnd"] = new csml.State {
      on {
        [Events.eBeamInterruptedEnd] {
          to = "unloading"
          yields {
            new csml.Emit {
              event = new csml.Event { topic = Events.eStartUnload }
              target = "'conveyorBelt'"
            }
          }
        }

        [Events.eJobDone] {
          to = "jobDone"
        }

        [Events.eBeamInterruptedStart] {
          yields {
            new csml.Eval {
              expression = "nextReceivedPartId += 1"
            }
          }
        }
      }
    }

    ["unloading"] = new csml.State {
      on {
        [Events.ePickedUp] {
          to = "detectingStart"
          yields {
            new csml.Emit {event {topic = Events.ePartProcessingComplete; data {
              ["partId"] = "nextPartToProcessId"
            }}
            target = "'collector'"
            }
            new csml.Eval {expression = "nextPartToProcessId += 1"}
          }
        }

        [Events.eJobDone] {
          to = "jobDone"
        }

        [Events.eBeamInterruptedStart] {
          yields {
            new csml.Eval {
              expression = "nextReceivedPartId += 1"
            }
          }
        }
      }
    }

    ["jobDone"] = new csml.Terminal {}
  }
}
